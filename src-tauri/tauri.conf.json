{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青灯",
  "version": "0.2.1",
  "identifier": "com.qingdeng.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "青灯",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:qingdeng.db"
      ]
    },
    "updater": {
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/Soulmte/qingdeng@cdn/latest.json",
        "https://github.com/Soulmte/qingdeng/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2RTE3QjVCRTRBMEYwMTIKUldRUzhLRGtXM3ZoUm1MWVR5ZnI1ZjFtVXpSTS9nUXUxcWtXR29uUkRGdEUzSFNMV1hWcnJ5bFEK"
    }
  }
}

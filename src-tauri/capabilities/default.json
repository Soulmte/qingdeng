{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口所需的能力集合",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top"
  ]
}
